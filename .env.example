# ==============================================================================
# SHAWEZGPT CONFIGURATION & MULTI-AI PROVIDER KEYS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI MULTI-KEY POOL (Auto-Rotation & Quota Failover)
# You can set 1, 2, 3 or more API keys. If one key hits Google rate limits (429),
# ShawezGPT automatically switches to the next key seamlessly without breaking chats!
# ------------------------------------------------------------------------------
GEMINI_API_KEY_1="YOUR_FIRST_GEMINI_API_KEY"
GEMINI_API_KEY_2="YOUR_SECOND_GEMINI_API_KEY"
GEMINI_API_KEY_3="YOUR_THIRD_GEMINI_API_KEY"

# Or provide a single comma-separated list of keys:
# GEMINI_API_KEYS="key1,key2,key3"

# Fallback default key name (also supported)
GEMINI_API_KEY="YOUR_FIRST_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. OLLAMA LOCAL / REMOTE AI ENGINE (Unlimited Quota & Offline AI)
# Run local open-source models (llama3, mistral, deepseek-r1, qwen2.5, phi4)
# Default is http://127.0.0.1:11434 (or your local IP / server URL)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# ------------------------------------------------------------------------------
# 3. APPLICATION & SYSTEM SETTINGS
# ------------------------------------------------------------------------------
DEFAULT_AI_MODEL="gemini-3.7-flash"
SYSTEM_BRAND_NAME="ShawezGPT"
PORT=3000
NODE_ENV="development"
